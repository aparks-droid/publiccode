# Optional. Most users connect their database, sources and AI inside the app.
# Keys entered in the app are stored locally in .company-brain/connections.json (gitignored).
# Never use NEXT_PUBLIC_ variables for private keys.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional model overrides. AI keys are entered in Connect AI, not here.
OPENAI_MODEL=gpt-5.4-mini
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional local port. The launcher starts the app and monitor together.
PORT=3000
# BRAIN_DEMO=1 renders the public sample preview without accessing a database.
